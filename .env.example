# Supabase — lấy từ Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng phía server (Server Actions, route handlers) — KHÔNG expose ra client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL của app — dùng cho email confirmation link
# Local: http://localhost:3456 (mặc định trong actions.ts)
# Production: BẮT BUỘC set, nếu không link xác nhận email sẽ trỏ về localhost
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
